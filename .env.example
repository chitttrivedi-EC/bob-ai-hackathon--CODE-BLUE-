# ============================================================
# ThreatLens AI — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# IBM watsonx.ai credentials (required for live BLUF generation)
# Get these from: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_ibm_cloud_api_key_here

# Your watsonx.ai project ID (from the Project Settings page)
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# watsonx regional endpoint — change if your project is in a different region
# Options: https://us-south.ml.cloud.ibm.com
#          https://eu-de.ml.cloud.ibm.com
#          https://au-syd.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Model to use for BLUF generation (Granite recommended for IBM Bob scoring)
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# ── Optional tuning ──────────────────────────────────────────
# Semantic similarity threshold for alert clustering (0.0 – 1.0)
# Lower = more permissive grouping. Default: 0.75
CORRELATION_THRESHOLD=0.75

# SQLite database path
DB_PATH=data/threatintel.db

# ATT&CK STIX cache path (downloaded on first run)
ATTACK_STIX_PATH=data/attack_stix.json

# Streamlit server port
STREAMLIT_PORT=8501
